    "mocha": "^11.7.6",
    "prettier": "^3.9.6",
    "qrcode-reader": "^1.0.4",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4"
  },
  "allowScripts": {
    "canvas@3.2.3": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
