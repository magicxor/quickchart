    "chartjs-chart-error-bars": "^4.4.5",
    "chartjs-chart-funnel": "^4.2.5",
    "chartjs-chart-geo": "^4.3.6",
    "chartjs-chart-graph": "^4.3.5",
    "chartjs-chart-pcp": "^4.3.5",
    "chartjs-chart-venn": "^4.3.7",
    "chartjs-chart-wordcloud": "^4.4.5",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-hierarchical": "^4.4.5",
